from Compiler.GC.types import *
import random

total = 1000000
rounds = 30

num_per_loop = total // rounds

a = []
b = []

for _ in range(num_per_loop + 10):
    a.append(sint(0))
    b.append(sint(0))

for rr in range(rounds):
    if rr == 0:
        for i in range(num_per_loop + 10):
            a[i] = a[i] * b[i]
        for i in range(num_per_loop + 10):
            a[i] = a[i] + b[i]
    else:
        for i in range(num_per_loop):
            a[i] = a[i] * b[i]
        for i in range(num_per_loop):
            a[i] = a[i] + b[i]
